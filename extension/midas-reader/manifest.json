{
  "manifest_version": 3,
  "name": "Analiz · Midas işlem aktarımı",
  "version": "0.19.1",
  "description": "Açık Midas işlem geçmişini kullanıcı isteğiyle Analiz'e yerel olarak aktarır.",
  "icons": {
    "16": "iconV1.png",
    "48": "iconV1.png",
    "128": "iconV1.png"
  },
  "action": {
    "default_icon": {
      "16": "iconV1.png",
      "48": "iconV1.png",
      "128": "iconV1.png"
    },
    "default_title": "Analiz · Midas işlem aktarımı"
  },
  "host_permissions": [
    "https://atlas.getmidas.com/*",
    "https://valaiso.github.io/Analiz/*",
    "https://query1.finance.yahoo.com/*",
    "https://www.tefas.gov.tr/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://atlas.getmidas.com/*"],
      "js": ["midas-reader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://valaiso.github.io/Analiz/*"],
      "js": ["analiz-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
